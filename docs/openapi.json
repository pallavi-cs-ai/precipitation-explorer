  "components": {
    "schemas": {
      "Coordinates": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "title": "Coordinates"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Interval": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "image_url"
        ],
        "title": "Interval"
      },
      "Manifest": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "title": "Schema Version"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "initialization": {
            "type": "string",
            "format": "date-time",
            "title": "Initialization"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "resolution": {
            "type": "number",
            "title": "Resolution"
          },
          "bounds": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bounds"
          },
          "units": {
            "type": "string",
            "title": "Units"
          },
          "interval_hours": {
            "type": "integer",
            "title": "Interval Hours"
          },
          "intervals": {
            "items": {
              "$ref": "#/components/schemas/Interval"
            },
            "type": "array",
            "title": "Intervals"
          },
          "thresholds": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Thresholds"
          },
          "colors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Colors"
          },
          "attribution": {
            "type": "string",
            "title": "Attribution"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_sha256": {
            "type": "string",
            "title": "Source Sha256"
          }
        },
        "type": "object",
        "required": [
          "schema_version",
          "run_id",
          "model",
          "initialization",
          "generated_at",
          "resolution",
          "bounds",
          "units",
          "interval_hours",
          "intervals",
          "thresholds",
          "colors",
          "attribution",
          "source",
          "source_sha256"
        ],
        "title": "Manifest"
      },
      "PointForecast": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "requested": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "sampled": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "units": {
            "type": "string",
            "title": "Units",
            "default": "mm"
          },
          "intervals": {
            "items": {
              "$ref": "#/components/schemas/PointInterval"
            },
            "type": "array",
            "title": "Intervals"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "requested",
          "sampled",
          "intervals"
        ],
        "title": "PointForecast"
      },
      "PointInterval": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "amount_mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Mm"
          }
        },
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "amount_mm"
        ],
        "title": "PointInterval"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
